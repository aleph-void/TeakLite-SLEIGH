# sleigh specification file for the Teak / TeakLite II DSP (Nintendo DSi and 3DS DSP)

define endian=little;
define alignment=2;

define space CODE    type=ram_space    size=3     wordsize=2        default;
define space DATA    type=ram_space    size=2     wordsize=2;
define space register type=register_space size=4;

# 40bit accumulators (a1s, b1s are the context-switch shadows of a1 and b1)
define register offset=0x0 size=5  [ a0 a1 b0 b1 a1s b1s ];
define bitrange a0l=a0[0,16]
                a0h=a0[16,16]
                a0e=a0[32,8]

                a1l=a1[0,16]
                a1h=a1[16,16]
                a1e=a1[32,8]

                b0l=b0[0,16]
                b0h=b0[16,16]
                b0e=b0[32,8]

                b1l=b1[0,16]
                b1h=b1[16,16]
                b1e=b1[32,8]
;

# GPR
define register offset=0x40 size=2  [ r0 r1 r2 r3 r4 r5 r6 r7 ];

# 32bit Multiply parms & results
define register offset=0x50 size=2  [ x0 y0 x1 y1 p0h ];
define register offset=0x60 size=4  [ p0 p1 ];

# Misc
define register offset=0x70 size=3  [ pc ];  # 18 bit
define register offset=0x78 size=2  [ sp sv mixp lc repc dvm vtr0 vtr1 stepi0 stepj0 ];
define register offset=0x90 size=2  [ prpage ];
# 16 bit alias that only names the pc in the Register operand
define register offset=0x98 size=2  [ pc16 ];

# User defined
define register offset=0xa0 size=2  [ ext0 ext1 ext2 ext3 ];

# Pseudo registers: composed from / decomposed into the flag and mode bytes below when an instruction
# reads or writes them (see the Compose*/Decompose* macros)
define register offset=0x100 size=2 [ st0 st1 st2 icr ];
define register offset=0x110 size=2 [ stt0 stt1 stt2 mod0 mod1 mod2 mod3 ];

# Address configuration (real registers: addressing reads their fields)
define register offset=0x120 size=2 [ ar0 ar1 arp0 arp1 arp2 arp3 ];
define register offset=0x130 size=2 [ cfgi cfgj ];
# bank-exchange shadows
define register offset=0x140 size=2 [ r0b r1b r4b r7b cfgib cfgjb stepi0b stepj0b ];
define register offset=0x160 size=3 [ bkstart0 bkstart1 bkstart2 bkstart3 bkend0 bkend1 bkend2 bkend3 ];
define register offset=0x190 size=2 [ bklc0 bklc1 bklc2 bklc3 ];

# shadows for context switching (cntx_s / cntx_r, interrupts) and bank exchange
define register offset=0x1a0 size=2 [ ar0b ar1b arp0b arp1b arp2b arp3b mod2s repcs ];
define register offset=0x1e0 size=1 [ SH_LM SH_VL SH_E SH_C SH_C1 SH_V SH_N SH_M SH_Z SH_R
                                      SW_PCMHI SW_SAT SW_SATA SW_HWM SW_S SW_PS0 SW_PS1 SW_PAGE SW_STP16 SW_CMD
                                      SW_IM0 SW_IM1 SW_IM2 SW_IMV SW_EPI SW_EPJ ];

# scratch registers used by the pseudo-register helpers
define register offset=0x1c0 size=2 [ wb wb2 ];
define register offset=0x1d0 size=5 [ wacc ];

define register offset=0x200 size=1 [ IU0 IU1               # st2
                                    IP0 IP1 IP2 IPV         # stt2
                                    ]
;
# Flags and modes, one byte each (better decompilation than bit fields of the 16 bit registers)
define register offset=0x300 size=1 [ LM VL E C V N M Z C1             # stt0
                                    R P0E P1E                          # stt1
                                    SAT SATA HWM S OU0 OU1 PS0 PS1     # mod0
                                    PAGE STP16 CMD EPI EPJ             # mod1
                                    IE CPC                             # mod3
                                    CCNTA CREP IM0 IM1 IM2 IMV
                                    IC0 IC1 IC2 NIMC OU2 OU3 OU4
                                    PCMHI BCN LP REP
                                    ]
;

# Context: AMOD selects the full model of modulo / bit-reversed addressing and the step modes (language variant
# "modulo"); the default variant treats every address register as a plain counter.
define register offset=0x400 size=4 contextreg;
define context contextreg
    AMOD = (0,0)
;

# The tokens, operand tables and instructions are generated by tools/gen_teak.py from the encoding table in
# tools/teak_insts.json; the macros are written by hand.
define pcodeop teak_trap;

@include "teak_tokens.sinc"
@include "teak_macros.sinc"
@include "teak_tables.sinc"
@include "teak_insts.sinc"

